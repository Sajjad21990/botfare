# Copy to .env and fill in. Never commit .env.

# --- PayPal (sandbox only; BotFare never calls live endpoints) ---
# Client ID of the sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox).
# The app must belong to a US business sandbox account and have Payouts enabled.
PAYPAL_CLIENT_ID=
# Secret of the same sandbox REST app.
PAYPAL_CLIENT_SECRET=
# Webhook ID from the sandbox app's Webhooks section, for a webhook pointing at
# https://<botfare-web>/api/paypal/webhook and subscribed to PAYMENT.CAPTURE.*,
# PAYMENT.PAYOUTS-ITEM.* and PAYMENT.PAYOUTSBATCH.* events. The route verifies every delivery
# against it and answers 503 while it is empty. Leave it empty locally: top-ups still credit on
# capture and payouts update through "Refresh status"; the webhook is the safety net when a
# browser drops after approval.
PAYPAL_WEBHOOK_ID=
# Email of the sandbox personal account that plays the publisher and receives test Payouts.
# pnpm seed sets it as the demo publisher's payout email.
PUBLISHER_PAYPAL_EMAIL=
# "true" turns on Log in with PayPal (sandbox) on /signin. First enable "Log in with PayPal" on the
# sandbox app and register the return URL <BOTFARE_URL>/api/auth/paypal/callback exactly, e.g.
# http://localhost:3000/api/auth/paypal/callback (README "Judge mode and Log in with PayPal").
PAYPAL_LOGIN_ENABLED=
# PayPal SANDBOX buyer account (fake money, never a real PayPal login) that /judge shows judges
# for approving a wallet top-up. Shown only when both are set. Optional.
JUDGE_SANDBOX_BUYER_EMAIL=
# Password of that sandbox buyer account (sandbox test credential, fake money). Optional.
JUDGE_SANDBOX_BUYER_PASSWORD=

# --- Database (docker compose: pnpm db:up) ---
# Main local database.
DATABASE_URL=postgres://botfare:botfare@localhost:5432/botfare
# Database the test suite resets freely.
TEST_DATABASE_URL=postgres://botfare:botfare@localhost:5432/botfare_test

# --- BotFare app ---
# Public base URL of the BotFare web app; the x402 facilitator lives at $BOTFARE_URL/api/x402.
# pnpm seed writes http://localhost:3000 when it is empty.
BOTFARE_URL=http://localhost:3000
# Long random string (32+ characters) used to sign session cookies. Required by `next start`;
# `next dev` falls back to a development secret when it is empty. The cookie is Secure whenever the
# request came over https (X-Forwarded-Proto or the URL), so http://localhost works in every browser.
SESSION_SECRET=

# --- Demo publisher and demo agent (written by pnpm seed; leave empty and run it) ---
# Site ID of the Crema Notes demo site (site_...). Without the three BOTFARE_* values the demo runs free.
BOTFARE_SITE_ID=
# Site secret for HTTP Basic auth to the facilitator. pnpm seed keeps it while it works;
# pnpm seed --rotate-site-secret issues a new one.
BOTFARE_SITE_SECRET=
# Demo agent key (bfk_...): key ID plus the Ed25519 private key. BotFare stores only the public half.
# The web app's research agent (/agent) pays with it; the model never sees it.
BOTFARE_AGENT_KEY=
# Public origin of the demo (optional): catalog.json URLs (default: the request's own origin), and
# the site origin pnpm seed registers (default http://localhost:4000).
DEMO_ORIGIN=
# The demo's public URL as people and agents see it (optional; default DEMO_ORIGIN, then
# http://localhost:4000): the curl commands on /judge, and the origin DEMO_INTERNAL_URL replaces.
DEMO_PUBLIC_URL=
# Where this BotFare server itself reaches the demo, when that differs from its public URL
# (optional, server-side only). The research agent's requests for DEMO_PUBLIC_URL's origin go here
# instead, e.g. http://demo:4000 in the judge Docker stack. Leave empty locally and on Render.
DEMO_INTERNAL_URL=
# "1" only inside the judge Docker stack (docker-compose.full.yml sets it for setup): pnpm seed then
# skips its "restart the demo" hint. Leave empty.
BOTFARE_JUDGE_DOCKER=

# --- Bot detection (demo publisher) ---
# Cloudflare Turnstile secret for the "Reading as a human? Continue free." check that botfare()
# shows a browser it suspects of automation. The value below is Cloudflare's public always-pass
# test secret, which pairs with the test site key 1x00000000000000000000AA that pnpm seed gives
# Crema Notes; it is the right default for local demos. In production, use the secret of your own
# Turnstile widget (dash.cloudflare.com > Turnstile) and set its site key in the dashboard's Bot
# detection tab. Leave it empty and the demo still works: Cloudflare's test site keys always use
# this test secret (even when a real secret is set), a real site key never accepts a test secret
# (botfare() logs it and turns the check off), and without a site key there is no human check.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- AI ---
# Anthropic API key for the analytics assistant (AG Studio) and the research agent. Without it the
# assistant shows "AI assistant needs an Anthropic key" and everything else works.
ANTHROPIC_API_KEY=
# Model ID for the analytics assistant and the research agent (optional). Empty means the default,
# claude-sonnet-5-5.
ANTHROPIC_MODEL=

# --- Publisher analytics ---
# AG Studio licence key (optional, read at build time). Without it AG Studio shows its watermark.
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
