# Copy to .env and fill in. Never commit .env.

# --- PayPal (sandbox only; BotFare never calls live endpoints) ---
# Client ID of the sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox).
# The app must belong to a US business sandbox account and have Payouts enabled.
PAYPAL_CLIENT_ID=
# Secret of the same sandbox REST app.
PAYPAL_CLIENT_SECRET=
# Webhook ID from the app's Sandbox Webhooks section (needed once deployed; leave empty until then).
PAYPAL_WEBHOOK_ID=
# Email of the sandbox personal account that plays the publisher and receives test Payouts.
PUBLISHER_PAYPAL_EMAIL=

# --- Database (docker compose: pnpm db:up) ---
# Main local database.
DATABASE_URL=postgres://botfare:botfare@localhost:5432/botfare
# Database the test suite resets freely.
TEST_DATABASE_URL=postgres://botfare:botfare@localhost:5432/botfare_test

# --- BotFare app ---
# Public base URL of the BotFare web app; the x402 facilitator lives at $BOTFARE_URL/api/x402.
# pnpm seed writes http://localhost:3000 when it is empty.
BOTFARE_URL=http://localhost:3000
# Long random string used to sign session cookies.
SESSION_SECRET=

# --- Demo publisher and demo agent (written by pnpm seed; leave empty and run it) ---
# Site ID of the Crema Notes demo site (site_...). Without the three BOTFARE_* values the demo runs free.
BOTFARE_SITE_ID=
# Site secret for HTTP Basic auth to the facilitator. pnpm seed keeps it while it works;
# pnpm seed --rotate-site-secret issues a new one.
BOTFARE_SITE_SECRET=
# Demo agent key (bfk_...): key ID plus the Ed25519 private key. BotFare stores only the public half.
BOTFARE_AGENT_KEY=
# Public origin of the demo (optional): catalog.json URLs (default: the request's own origin), and
# the site origin pnpm seed registers (default http://localhost:4000).
DEMO_ORIGIN=

# --- AI (from Wednesday) ---
# Anthropic API key for the research agent and the AG Studio assistant.
ANTHROPIC_API_KEY=
# Model ID for the research agent (optional; the app has a default).
ANTHROPIC_MODEL=
